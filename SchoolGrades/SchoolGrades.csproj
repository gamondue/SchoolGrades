<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
	<!-- Version configuration - change these numbers when you want to update the version -->
	<VersionMajor>0</VersionMajor>
	<VersionMinor>90</VersionMinor>
	<!-- Calculate version with build date at compile time -->
	<DaysSince2000>$([System.DateTime]::Now.Subtract($([System.DateTime]::new(2000,1,1))).Days)</DaysSince2000>
	<SecondsSinceMidnight>$([System.Convert]::ToInt32($([MSBuild]::Divide($([System.DateTime]::Now.TimeOfDay.TotalSeconds), 2))))</SecondsSinceMidnight>
	<Version>$(VersionMajor).$(VersionMinor).$(DaysSince2000).$(SecondsSinceMidnight)</Version>
	<AssemblyVersion>$(Version)</AssemblyVersion>
	<FileVersion>$(Version)</FileVersion>
	<Deterministic>false</Deterministic>
    <Authors>Ing. Gabriele Monti - Forlì - Italia</Authors>
    <Copyright>Copyleft GPL Licence - Initiated and managed by Ing. Gabriele Monti - Forlì - Italia</Copyright>
    <PackageLicenseExpression>GPLv2</PackageLicenseExpression>
    <Description>SchoolGrades manages the daily life of a teacher in the classroom, with emphasis to evaluations and tracking of topics done.</Description>
    <RepositoryType>git source code repository</RepositoryType>
    <RepositoryUrl>https://github.com/gamondue/SchoolGrades</RepositoryUrl>
    <PackageReleaseNotes>SchoolGrades. .Net 6 version. Version number of .Net Core code or subsequents starts from 0.50. 
Published on GitHub with GPL v.2 licence. 
Versions with numbers under 0.50 were made with .Net Framework.</PackageReleaseNotes>
    <PackageIcon>Icons/gamon LegoLogo decentrato trasparente 256x256.png</PackageIcon>
    <ApplicationIcon>gamon LegoLogo decentrato trasparente 256x256.ico</ApplicationIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPublishable>True</IsPublishable>
	<DefineConstants>WINFORMS</DefineConstants>
	<DefineConstants>SQLITE</DefineConstants>
	<Title>SchoolGrades</Title>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".github\**" />
    <EmbeddedResource Remove=".github\**" />
    <None Remove=".github\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Auguri.wav" />
    <None Remove="Resources\IL SILENZIO.wav" />
    <None Remove="Resources\La Sveglia.wav" />
    <None Remove="Resources\Lo squalo.wav" />
    <None Remove="Resources\Rigoletto.wav" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="gamon LegoLogo decentrato trasparente 256x256.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Auguri.wav" />
    <EmbeddedResource Include="Resources\IL SILENZIO.wav" />
    <EmbeddedResource Include="Resources\La Sveglia.wav" />
    <EmbeddedResource Include="Resources\Lo squalo.wav" />
    <EmbeddedResource Include="Resources\Rigoletto.wav" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.11" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
    <PackageReference Include="SQLitePCLRaw.core" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Icons\gamon LegoLogo decentrato trasparente 256x256.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.en.resx">
      <!-- Satellite resource files should NOT have a generator -->
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Import Project="..\BusinessLayer\BusinessLayer.projitems" Label="Shared" />

  <Import Project="..\BusinessObjects\BusinessObjects.projitems" Label="Shared" />

  <Import Project="..\SharedItems\SharedItems.projitems" Label="Shared" />

  <Import Project="..\DataLayer\DataLayer.projitems" Label="Shared" />

  <Import Project="..\SharedWinForms\SharedWinForms.projitems" Label="Shared" />

  <Import Project="..\TreeMpttManagement\MpttTreeManagement.projitems" Label="Shared" />

  <Import Project="..\TreeMpttWinForms\TreeMpttWinForms.projitems" Label="Shared" />

  <!-- Update AssemblyInfo.cs with build date before compilation -->
  <Target Name="UpdateAssemblyVersionInfo" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <DaysSince2000>$([System.DateTime]::Now.Subtract($([System.DateTime]::new(2000,1,1))).Days)</DaysSince2000>
      <SecondsSinceMidnight>$([System.Convert]::ToInt32($([MSBuild]::Divide($([System.DateTime]::Now.TimeOfDay.TotalSeconds), 2))))</SecondsSinceMidnight>
      <NewVersion>1.0.$(DaysSince2000).$(SecondsSinceMidnight)</NewVersion>
      <AssemblyInfoPath>$(ProjectDir)Properties\AssemblyInfo.cs</AssemblyInfoPath>
    </PropertyGroup>
    <Message Importance="high" Text="Updating SchoolGrades version to: $(NewVersion)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; { $content = Get-Content '$(AssemblyInfoPath)' -Raw; $content = $content -replace '\[assembly: AssemblyVersion\(&quot;.*?&quot;\)\]', '[assembly: AssemblyVersion(&quot;$(NewVersion)&quot;)]'; $content = $content -replace '\[assembly: AssemblyFileVersion\(&quot;.*?&quot;\)\]', '[assembly: AssemblyFileVersion(&quot;$(NewVersion)&quot;)]'; $content = $content -replace '\[assembly: AssemblyInformationalVersion\(&quot;.*?&quot;\)\]', '[assembly: AssemblyInformationalVersion(&quot;$(NewVersion)&quot;)]'; Set-Content '$(AssemblyInfoPath)' -Value $content -NoNewline }&quot;" />
  </Target>
</Project>