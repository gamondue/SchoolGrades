@implements IDisposable

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-warning" style="position:fixed;top:20px;right:20px;z-index:9999;">
        @Message
        <button class="btn btn-sm btn-link" @onclick="Close">Chiudi</button>
    </div>
}

@code {
    [Parameter] public int TimeoutMs { get; set; } = 3000;
    private string? Message;
    private System.Timers.Timer? timer;

    protected override void OnInitialized()
    {
        SchoolGrades.Commons.OnShowMessage += Show;
    }

    private void Show(string msg)
    {
        Message = msg;
        StateHasChanged();
        timer?.Dispose();
        timer = new System.Timers.Timer(TimeoutMs);
        timer.Elapsed += (_, _) => Close();
        timer.AutoReset = false;
        timer.Start();
    }

    private void Close()
    {
        Message = null;
        InvokeAsync(StateHasChanged);
        timer?.Dispose();
    }

    public void Dispose()
    {
        SchoolGrades.Commons.OnShowMessage -= Show;
        timer?.Dispose();
    }
}