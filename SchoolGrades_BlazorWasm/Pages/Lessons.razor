        border: 1px solid #eee;
        border-radius: 5px;
        margin-bottom: 8px;
        cursor: pointer;
        transition: all 0.3s;
    }

    .lesson-item:hover {
        background: #f0f8ff;
        border-color: #2196F3;
    }

    .lesson-item.selected {
        background: #e3f2fd;
        border-color: #2196F3;
