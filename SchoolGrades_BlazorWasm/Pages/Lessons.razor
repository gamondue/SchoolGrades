    }

    .lesson-date {
        font-weight: bold;
        color: #333;
        margin-bottom: 5px;
    }

    .lesson-preview {
        font-size: 12px;
        color: #666;
        line-height: 1.3;
    }

    .topic-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 5px 8px;
        border-radius: 3px;
        cursor: pointer;
        margin-bottom: 3px;
    }

    .topic-item:hover {
        background: #f0f8ff;
    }

    .center-panel {
        background: white;
        border-radius: 8px;
        padding: 20px;
        overflow-y: auto;
    }

    .lesson-details {
        height: 100%;
    }

    .lesson-form {
        display: flex;
        flex-direction: column;
        gap: 15px;
        height: 100%;
    }

    .form-row {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 15px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group label {
        font-weight: bold;
        margin-bottom: 5px;
        color: #333;
    }

    .form-control {
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
    }

    .lesson-description {
        flex: 1;
        min-height: 150px;
        resize: vertical;
    }

    .topics-digest {
