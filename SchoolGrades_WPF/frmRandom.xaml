<Window x:Class="SchoolGrades_WPF.frmRandom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SchoolGrades_WPF"
        mc:Ignorable="d"
        Title="Numero casuale" Height="175" Width="230" 
        ResizeMode="NoResize" Background="PowderBlue">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="Da"
               VerticalAlignment="Bottom"
               HorizontalContentAlignment="Center" 
               FontSize="20" Foreground="DarkBlue" 
               Margin="5"/>
        <Label Grid.Row="0" Grid.Column="1" Content="A" 
               VerticalAlignment="Bottom"
               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
               FontSize="20" Foreground="DarkBlue"
               Margin="5"/>

        <TextBox Grid.Row="1" Grid.Column="0" x:Name="txtFrom" 
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                 FontSize="20" Text="1"
                 Margin="5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtTo" 
                 HorizontalContentAlignment="Center"
                 FontSize="20"
                 Margin="5"/>
        
        <TextBox Grid.Row="2" Grid.Column="0" x:Name="txtResult" 
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                 FontSize="20"
                 Margin="5"/>
        <Button Grid.Row="2" Grid.Column="1" x:Name="btnDraw" 
                Content="Sorteggio"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                FontSize="20"
                Margin="5" Click="btnDraw_Click"/>
    </Grid>
</Window>
