<Window x:Class="SchoolGrades_WPF.frmClassesManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SchoolGrades_WPF"
        mc:Ignorable="d"
        Title="Gestione classi" Height="500" Width="1200">

    <Grid Background="#FFB2DADA">
        <Grid.RowDefinitions>
            <RowDefinition Height="28*" ></RowDefinition>
            <RowDefinition Height="53*" ></RowDefinition>
            <RowDefinition Height="104*"></RowDefinition>
            <RowDefinition Height="56*"></RowDefinition>
            <RowDefinition Height="61*"></RowDefinition>
            <RowDefinition Height="61*"></RowDefinition>
            <RowDefinition Height="61*"></RowDefinition>
            <RowDefinition Height="61*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="203*"></ColumnDefinition>
            <ColumnDefinition Width="487*"></ColumnDefinition>
            <ColumnDefinition Width="261*"></ColumnDefinition>
            <ColumnDefinition Width="249*"></ColumnDefinition>
        </Grid.ColumnDefinitions>


        <Label Content="Codice scuola" Grid.Row="0" Grid.Column="0" Margin="10,0,477,53" Grid.RowSpan="2" Foreground="DarkBlue" RenderTransformOrigin="0.631,0.63" Grid.ColumnSpan="2"  />
        <Label Content="Anno scolastico" Grid.Row="0" Grid.Column="1" Margin="0,0,0,53" Grid.RowSpan="2" Foreground="DarkBlue"   />
        <Label Content="Sigla classe" Grid.Row="0" Grid.Column="1" Margin="110,0,0,53" Grid.RowSpan="2" Foreground="DarkBlue" />
        <Label Content="Desrizione classe" Grid.Row="0" Grid.Column="1" Margin="210,0,0,53" Grid.RowSpan="2" Foreground="DarkBlue" />

        <ComboBox Grid.Column="1" Grid.Row="1" Margin="10,10,391,10" BorderBrush="White" Background="White"/>
        <ComboBox Grid.Column="1" Grid.Row="1" Margin="110,10,294,10" BorderBrush="White"/>
        <Label Content="File dati da cui importare" Grid.Row="2" Grid.Column="0" Margin="10,29,486,48" RenderTransformOrigin="0.5,0.5" FontSize="13" Grid.ColumnSpan="2" Foreground="DarkBlue" >

        </Label>
        <Label Content="importazioni classi da file" Grid.Row="2" Grid.Column="0" Margin="10,0,486,79" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="2" FontSize="14" Foreground="Black"/>
        <TextBox TextWrapping="Wrap" Margin="10,10,39,15" Grid.Row="1" TextChanged="TextBox_TextChanged" Text="FOIS01100L" FontSize="14" x:Name="TxtOfficialSchoolAbbreviation" />
        <TextBox TextWrapping="Wrap" Margin="210,10,10,10" Grid.Row="1" Grid.Column="1" TextChanged="TextBox_TextChanged_1" x:Name="txtClassDescription"/>
        <TextBox TextWrapping="Wrap" Margin="10,33,10,47" Grid.Row="2" Grid.Column="1" TextChanged="TextBox_TextChanged_2" x:Name="TxtFileOfStudentsImport"/>
        <TextBox TextWrapping="Wrap" Margin="10,74,10,7" Grid.Row="2" Grid.Column="1" x:Name="TxtImagesOriginFolder" />
        <Label Content="Cartella origine immagine" Grid.Row="2" Grid.Column="0" Margin="10,63,10,7" RenderTransformOrigin="0.5,0.5" FontSize="13" Foreground="DarkBlue"/>
        <RadioButton Content="Foto presenti" Grid.Column="2" Margin="130,13,10,75" Grid.Row="2" Foreground="DarkBlue" x:Name="rdbStudentsPhotosAlreadyPresent" />
        <RadioButton Content="Richiesta foto " Grid.Column="2" Margin="130,44,10,42" Grid.Row="2" Foreground="DarkBlue"  x:Name="rdbChooseStudentsPhotoWhileImporting"/>
        <RadioButton Content="Nessuna foto" Grid.Column="2" Margin="130,75,9,13" Grid.Row="2" Foreground="DarkBlue"  x:Name="rdbDoNotImportPhotos" />
        <Button Content="IMPORTA &#xA;CLASSE" Grid.Column="3" Margin="55,21,64,13" Grid.Row="2" Background="White" FontWeight="Bold" Foreground="DarkBlue" FontSize="18" x:Name="btnImportStudentsOfClass" />
        <Button Content="Nuovo &#xA;allievo" Margin="10,5,136,5" Grid.Row="3" Background="White" Foreground="DarkBlue" FontWeight="Bold" FontSize="14" x:Name="btnStudentNew"/>
        <Button Content="Elimina&#xA;allievo" Margin="74,5,73,5" Grid.Row="3" Foreground="DarkBlue" FontSize="14" FontWeight="Bold" Background="White"  x:Name="BtnStudentErase"/>
        <Button Content="Cambia foto &#xA;allievo" Margin="11,5,376,5" Grid.Row="3" Grid.Column="1" Foreground="DarkBlue" FontSize="14" FontWeight="Bold" Background="White" x:Name="BtnPhotoChange" />
        <Button Content="Cambia abilitaz.&#xA;allievo " Margin="221,5,144,5" Grid.Row="3" Grid.Column="1" Click="Button_Click_3" FontSize="14" Foreground="DarkBlue" FontWeight="Bold" BorderBrush="#FF898D8D" Background="White" x:Name="btnToggleDisableStudent"/>
        <Button Content="Modifica &#xA;allievo" Margin="355,5,48,5" Grid.Row="3" Grid.Column="1" FontSize="14" FontWeight="Bold" Foreground="DarkBlue" Background="White" x:Name="BtnModifyStudent"/>
        <Button Content="Numero &#xA;registro" Margin="19,5,144,5" Grid.Row="3" Grid.Column="2" Background="White" Foreground="DarkBlue" FontWeight="Bold" FontSize="14" x:Name="btnPutNumbers"/>
        <Button Content="Elimina&#xA;classe" Margin="140,5,25,5" Grid.Row="3" Grid.Column="2" Background="White" Foreground="DarkBlue" FontWeight="Bold" FontSize="14" x:Name="btnClassErase"/>
        <Button Content="Fine &#xA;periodo" Margin="25,5,143,5" Grid.Row="3" Grid.Column="3" Background="White" Foreground="DarkBlue" FontSize="14" FontWeight="Bold" Click="Button_Click_4" x:Name="btnEndingPeriod"/>
        <Button Content="nuovo &#xD;&#xA;anno" Margin="135,5,35,5" Grid.Row="3" Grid.Column="3" Background="White" Foreground="DarkBlue" FontSize="14" FontWeight="Bold" x:Name="btnNewYear"/>
        <TextBox TextWrapping="Wrap" Margin="10,19,10,15" Grid.Row="4" Grid.Column="1" x:Name="TxtStartLinksFolder"/>
        <Image  x:Name="picStudent"  Margin="148,3,435,4" Grid.Row="3" Grid.ColumnSpan="2" OpacityMask="PowderBlue" />
        <Label Content="cartella start links" Grid.Row="4" Grid.Column="0" Margin="10,16,38,10" RenderTransformOrigin="0.5,0.5" FontSize="13"/>
        <TextBox TextWrapping="Wrap" Margin="10,28,91,10" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="&lt;FirstName&gt;.&lt;LastName&gt; . stud@ispascalcomandini.it&#xD;&#xA;" FontSize="14"/>
        <Button Content="..." Margin="32,29,193,47" Grid.Row="2" Grid.Column="2" Click="Button_Click_1" Background="White" x:Name="btnFileChoose" />
        <Button Content="..." Margin="32,70,193,10" Grid.Row="2" Grid.Column="2" Click="Button_Click_1" Background="White" x:Name="btnPathImages" />
        <Button Content="..." Margin="32,21,193,15" Grid.Row="4" Grid.Column="2" Click="Button_Click_1" Background="White" x:Name="btnPathStartLinks"/>
        <Button Content="Elenco" Margin="25,14,143,14" Grid.Row="4" Grid.Column="3" Background="White" Foreground="DarkBlue" FontSize="14" FontWeight="Bold" x:Name="btnStudentsInfoList"/>


        <Button Content="indir. email" Margin="25,23,103,5" Grid.Row="5" Grid.Column="3" Background="White" Foreground="DarkBlue" FontSize="14" FontWeight="Bold" x:Name="btnCreateEmailAddresses"/>
        <Label Content="dati classe (F2 per modificare)" Grid.Row="5" Grid.Column="0" Margin="10,21,10,5" RenderTransformOrigin="0.5,0.5" FontSize="13" x:Name="label10"/>
        <Label Content="parttern per generazione email" Grid.Row="4" Grid.Column="1" Margin="10,60,275,33" RenderTransformOrigin="0.5,0.5" FontSize="13" Grid.RowSpan="2" x:Name="label11"/>
        <DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="3" Margin="10,3,10,10" Grid.Row="6" SelectionChanged="DataGrid_SelectionChanged_1" x:Name="DgwClass"/>
        <Button Content="salva classe studenti" Margin="25,11,64,17" Grid.Row="6" Grid.Column="3" FontSize="14" Foreground="DarkBlue" FontWeight="Bold" Background="White" x:Name="btnSaveClassAndStudents"/>
        <DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="4" Margin="10,3,10,10" Grid.Row="7" x:Name="DgwStudents"/>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="5" Grid.ColumnSpan="4" Margin="10,61,239,10" Grid.RowSpan="2" Background="Gray"/>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="6" Grid.ColumnSpan="4" Margin="10,61,10,0" Background="Gray" Grid.RowSpan="2"/>
        <Button Content="Elimina foto&#xD;&#xA;allievo" Margin="116,5,275,5" Grid.Row="3" Grid.Column="1" Click="Button_Click_2" Foreground="DarkBlue" FontSize="14" FontWeight="Bold" Background="White" x:Name="btnPhotoErase"/>
         

    </Grid>




</Window>

